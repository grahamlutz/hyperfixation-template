# Every name here is in REQUIRED_ENV (src/env.ts), and `tests/compose-envs.test.ts` fails if
# this file and that list disagree. Copy to `.env` for local development; production values
# come from Coolify.

# web | worker | migrate. `pnpm dev` is the web; `pnpm worker` must run with HF_PROCESS=worker.
HF_PROCESS=web
# `hf dev` sets this to dev-<timestamp>; in a container it comes from the SOURCE_COMMIT build
# arg. Anything shorter than 7 characters is refused.
HF_BUILD_SHA=dev-0000000

# The application role. Owns nothing; CONNECTION LIMIT 25.
DATABASE_URL=postgres://hf___APP_NAME__:hf___APP_NAME__@localhost:5432/__DB_NAME__
# The migrator role. Owns every hf_* object; used only by the migrate service.
MIGRATOR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/__DB_NAME__

APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-secret-change-me

# Two forms, told apart by the scheme. Anything but `cloudflare-email://` is a nodemailer
# transport URL — here, the mailpit service in docker-compose.yml, inbox at
# http://localhost:8025. `cloudflare-email://<api_token>@<account_id>` sends through Cloudflare
# Email Sending's REST API over HTTPS instead, for a host that cannot reach outbound 465.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=__APP_NAME__@localhost

# Empty locally. An empty SENTRY_DSN is not "Sentry with no DSN" but no Sentry at all: neither
# instrumentation.ts (web) nor src/boot-sentry.ts (worker) so much as imports the SDK. Set it and
# both capture errors only — no traces, no PII, no request bodies. No SENTRY_AUTH_TOKEN is
# needed; nothing uploads source maps.
#
# The three Langfuse vars are all-or-nothing — instrumentation.ts (web) and startWorker()
# (worker) register the span processor only when none of the three is empty, and nothing at all
# otherwise.
SENTRY_DSN=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
