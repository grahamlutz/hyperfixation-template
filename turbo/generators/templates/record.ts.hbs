import { hfRecordColumns } from "@hyperfixation/db";
import { sql } from "drizzle-orm";
import { bigint, index, pgTable } from "drizzle-orm/pg-core";

/**
 * A record table. The three shape rules are boot checks, not conventions: a `bigint` identity
 * primary key named `id` (E001), a trigram index on `normalized_name` (E003), and no foreign
 * key to any `hf_*` table (E004). A worker that finds any of them broken refuses to launch.
 *
 * `hfRecordColumns()` is everything the machinery reads and writes on a record —
 * `normalized_name`, `archived_at`, `stage`, the score pair, `spec_version`. It never declares
 * the index: E003 wants a `gin_trgm_ops` opclass, which Drizzle only emits from the raw
 * expression below, so the index stays the app's to declare. Add this app's own columns
 * after the spread; a column declared there wins, which is how a mixin column gets tightened
 * to `NOT NULL` or made unique.
 *
 * Run `pnpm db:generate` after editing this, and never let an app migration touch an `hf_*`
 * table — that is E005, and it fails the migrator before it fails the worker.
 */
export const {{name}} = pgTable(
  "{{snakeCase name}}",
  {
    id: bigint("id", { mode: "bigint" }).primaryKey().generatedAlwaysAsIdentity(),
    ...hfRecordColumns(),
  },
  (t) => [
    index("{{snakeCase name}}_normalized_name_trgm").using(
      "gin",
      sql`${t.normalizedName} gin_trgm_ops`,
    ),
  ],
);
